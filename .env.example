# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored — never commit real secrets.

# --- Databases ---
MYSQL_ROOT_PASSWORD=change-me-mysql
MONGO_USER=ead
MONGO_PASSWORD=change-me-mongo

# Host ports for connecting from your machine (avoid clashing with local installs)
MYSQL_CUSTOMER_HOST_PORT=3307
MYSQL_PRODUCT_HOST_PORT=3308
MYSQL_ORDER_HOST_PORT=3309
MONGO_HOST_PORT=27018

# --- Auth ---
# Base64 HMAC key shared by the gateway and the customer service.
# This is the original dev key from the code; generate a new one for any real deployment:
#   openssl rand -base64 48
JWT_SECRET=BF7FD11ACE545745B7BA1AF98B6F156D127BC7BB544BAB6A4FD74E4FC7

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=

# --- Mail (customer service: password reset etc.) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend ---
FRONTEND_PORT=3000
# Origin allowed by the gateway's CORS config
FRONTEND_ORIGIN=http://localhost:3000
